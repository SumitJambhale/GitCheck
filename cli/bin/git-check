#!/usr/bin/env python3
import sys
import os
import subprocess
from pathlib import Path

# If click is missing in the current virtualenv, re-exec with the Python where git-check dependencies exist
try:
    import click
    import rich
except ImportError:
    candidate_pythons = [
        "/Library/Frameworks/Python.framework/Versions/3.14/bin/python3",
        "/usr/local/bin/python3",
        "/opt/homebrew/bin/python3",
        "/usr/bin/python3"
    ]
    for py in candidate_pythons:
        if os.path.exists(py) and os.access(py, os.X_OK) and py != sys.executable:
            try:
                res = subprocess.run([py, "-c", "import click, rich"], capture_output=True)
                if res.returncode == 0:
                    os.execv(py, [py] + sys.argv)
                    sys.exit(0)
            except Exception:
                continue

# Add cli directory to sys.path so git_check package can be loaded anywhere
cli_root = Path(__file__).resolve().parent.parent
if str(cli_root) not in sys.path:
    sys.path.insert(0, str(cli_root))

from git_check.main import cli

if __name__ == "__main__":
    cli()
